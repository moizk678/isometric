#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1090
  eval "$(./scripts/load-env)"
  set +a
fi

export PYTHONPATH="services/api:services/worker:packages/pipeline:packages/persistence"
.venv/bin/python -m unittest discover -s services/api/tests -p 'test_*.py' -v
.venv/bin/python -c 'import isometric_api; assert isometric_api.__version__ == "0.1.0"'
.venv/bin/python -c 'import isometric_worker; assert isometric_worker.__version__ == "0.1.0"'
