#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1090
  eval "$(./scripts/load-env)"
  set +a
fi

PYTHONPATH="packages/pipeline:packages/persistence" .venv/bin/python -m unittest discover \
  -s packages/persistence/tests -p 'test_*.py' -v
