#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

.venv/bin/ruff check services packages
.venv/bin/ruff format --check services packages
if [[ -z "${LOCAL_DATABASE_URL:-}" ]]; then
  echo "LOCAL_DATABASE_URL is required for Run 03 persistence checks" >&2
  exit 1
fi
./scripts/migrate-replay
./scripts/test-persistence
./scripts/check-scene-schema
PYTHONPATH=packages/pipeline .venv/bin/python -m isometric_pipeline.render.golden --check
./scripts/export-openapi
if ! git diff --quiet -- services/api/openapi.json; then
  echo "services/api/openapi.json is out of date; run ./scripts/export-openapi" >&2
  git diff -- services/api/openapi.json >&2 || true
  exit 1
fi
./scripts/test-api
./scripts/test-pipeline
./scripts/test-web
./scripts/test-web-e2e
