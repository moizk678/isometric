#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

test "$(python3.12 --version)" = 'Python 3.12.12'
test "$(node --version)" = 'v26.0.0'
test "$(pnpm --version)" = '10.23.0'

python3.12 -m venv .venv
.venv/bin/python -m pip install --disable-pip-version-check -r requirements-dev.lock
pnpm install --frozen-lockfile
