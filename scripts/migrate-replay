#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1090
  eval "$(./scripts/load-env)"
  set +a
fi

if [[ -z "${SUPABASE_DATABASE_URL:-}" && -z "${SUPABASE_DEVELOPMENT_DATABASE_URL:-}" ]]; then
  echo "SUPABASE_DATABASE_URL is required" >&2
  exit 1
fi

PYTHONPATH=packages/persistence .venv/bin/python - <<'PY'
from isometric_persistence.config import load_database_settings
from isometric_persistence.db import DatabasePool
from isometric_persistence.migrate import apply_migrations

settings = load_database_settings()
pool = DatabasePool(settings)
with pool.connection() as conn:
    first = apply_migrations(conn)
    conn.commit()
    second = apply_migrations(conn)
    conn.commit()
if second:
    raise SystemExit("second migration pass applied new files; expected no-op")
print(f"migrations ok ({len(first)} applied on first pass)")
pool.close()
PY
