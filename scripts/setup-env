#!/usr/bin/env bash
# Write .env and apps/web/.env.local for Supabase-backed development.
set -euo pipefail
cd "$(dirname "$0")/.."

PROJECT_REF="${SUPABASE_PROJECT_REF:-bhezwfoifroyidfwdvcy}"
PUBLIC_SUPABASE_URL="${NEXT_PUBLIC_SUPABASE_URL:-https://${PROJECT_REF}.supabase.co}"
PUBLIC_SUPABASE_KEY="${NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:-}"
DB_HOST="${SUPABASE_DB_HOST:-db.${PROJECT_REF}.supabase.co}"
POOLER_HOST="${SUPABASE_POOLER_HOST:-aws-0-ap-southeast-1.pooler.supabase.com}"

if [[ -f .env && "${FORCE_SETUP_ENV:-}" != "1" ]]; then
  echo ".env already exists; set FORCE_SETUP_ENV=1 to overwrite" >&2
  exit 0
fi

if [[ -z "${SUPABASE_DB_PASSWORD:-}" && -f .private/supabase-db-password ]]; then
  SUPABASE_DB_PASSWORD="$(< .private/supabase-db-password)"
fi

if [[ -z "${SUPABASE_DB_PASSWORD:-}" ]]; then
  if [[ -t 0 ]]; then
    read -rsp "Supabase database password (Settings → Database): " SUPABASE_DB_PASSWORD
    echo
  else
    echo "Set SUPABASE_DB_PASSWORD or create .private/supabase-db-password" >&2
    exit 1
  fi
fi

if [[ ! -x .venv/bin/python ]]; then
  echo "Run ./scripts/setup first" >&2
  exit 1
fi

ENC_PASSWORD="$(SUPABASE_DB_PASSWORD="$SUPABASE_DB_PASSWORD" .venv/bin/python - <<'PY'
import os
import urllib.parse

print(urllib.parse.quote(os.environ["SUPABASE_DB_PASSWORD"], safe=""))
PY
)"

DATABASE_URL="postgresql://postgres.${PROJECT_REF}:${ENC_PASSWORD}@${POOLER_HOST}:6543/postgres"
DIRECT_URL="postgresql://postgres:${ENC_PASSWORD}@${DB_HOST}:5432/postgres"

cat > .env <<EOF
# Generated by ./scripts/setup-env — server-side only; never commit.
API_ORIGIN=http://127.0.0.1:8000
DEV_OWNER_ID=dev-owner
PORT=8000

SUPABASE_PROJECT_REF=${PROJECT_REF}
SUPABASE_DATABASE_URL=${DATABASE_URL}
SUPABASE_DEVELOPMENT_DATABASE_URL=${DATABASE_URL}
SUPABASE_DATABASE_DIRECT_URL=${DIRECT_URL}

ARTIFACT_ROOT=.private/artifacts

# Vision lane disabled for current runs
VISION_ENABLED=false
EOF

mkdir -p apps/web
cat > apps/web/.env.local <<EOF
# Generated by ./scripts/setup-env — Next.js (gitignored).
API_ORIGIN=http://127.0.0.1:8000
DEV_OWNER_ID=dev-owner

NEXT_PUBLIC_SUPABASE_URL=${PUBLIC_SUPABASE_URL}
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${PUBLIC_SUPABASE_KEY}
EOF

mkdir -p .private/artifacts
chmod 600 .env apps/web/.env.local 2>/dev/null || true

echo "Wrote .env and apps/web/.env.local"
echo "Test: ./scripts/migrate-replay"
