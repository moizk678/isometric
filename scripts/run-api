#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1090
  eval "$(./scripts/load-env)"
  set +a
fi

export PYTHONPATH="services/api:services/worker:packages/pipeline:packages/persistence"
exec .venv/bin/uvicorn isometric_api.app:app --host 0.0.0.0 --port "${PORT:-8000}"
