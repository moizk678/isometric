#!/usr/bin/env bash
# Starts the FastAPI app against Supabase for Playwright's webServer.
set -euo pipefail
cd "$(dirname "$0")/../../.."
if [[ -f .env ]]; then
  set -a
  # shellcheck disable=SC1090
  eval "$(./scripts/load-env)"
  set +a
fi

if [[ -z "${SUPABASE_DATABASE_URL:-}" && -z "${SUPABASE_DEVELOPMENT_DATABASE_URL:-}" ]]; then
  echo "SUPABASE_DATABASE_URL is required" >&2
  exit 1
fi

./scripts/migrate-replay
exec ./scripts/run-api
