# Next.js dev server proxy target (server-side only).
API_ORIGIN=http://127.0.0.1:8000

# Owner id injected as X-Owner-Id by the web proxy (server-side only).
DEV_OWNER_ID=dev-owner

# Local PostgreSQL URL for development only.
LOCAL_DATABASE_URL=

# Separate Supabase PostgreSQL URLs for deployed environments. Server-side only.
SUPABASE_DEVELOPMENT_DATABASE_URL=
SUPABASE_STAGING_DATABASE_URL=
SUPABASE_PRODUCTION_DATABASE_URL=

# Local artifact root for filesystem ArtifactStore (optional).
ARTIFACT_ROOT=

# Private artifact storage endpoint, bucket, and server-side credentials.
ARTIFACT_ENDPOINT=
ARTIFACT_BUCKET=
ARTIFACT_ACCESS_KEY_ID=
ARTIFACT_SECRET_ACCESS_KEY=

# Durable queue endpoint and server-side credential.
QUEUE_URL=
QUEUE_CREDENTIAL=

# Optional vision lane. Leave disabled unless a later run approves a provider.
VISION_ENABLED=
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=
