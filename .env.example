# Next.js (apps/web/.env.local) — API proxy is server-side; Supabase keys are public in the bundle.
API_ORIGIN=http://127.0.0.1:8000
DEV_OWNER_ID=dev-owner
NEXT_PUBLIC_SUPABASE_URL=https://bhezwfoifroyidfwdvcy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Run ./scripts/setup-env once (needs Supabase database password). Or set manually:
SUPABASE_PROJECT_REF=bhezwfoifroyidfwdvcy
SUPABASE_DATABASE_URL=
SUPABASE_DEVELOPMENT_DATABASE_URL=
SUPABASE_DATABASE_POOLER_URL=
SUPABASE_STAGING_DATABASE_URL=
SUPABASE_PRODUCTION_DATABASE_URL=

# Local artifact root for filesystem ArtifactStore (optional).
ARTIFACT_ROOT=

# Private artifact storage endpoint, bucket, and server-side credentials.
ARTIFACT_ENDPOINT=
ARTIFACT_BUCKET=
ARTIFACT_ACCESS_KEY_ID=
ARTIFACT_SECRET_ACCESS_KEY=

# Durable queue endpoint and server-side credential.
QUEUE_URL=
QUEUE_CREDENTIAL=

# Optional drawing reading lane (Workers AI with Gemini fallback). CI keeps this off.
VISION_ENABLED=
CLOUDFLARE_ACCOUNT_ID=
VISION_API_KEY=
VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
DRAWING_READING_TIMEOUT_SECONDS=120
